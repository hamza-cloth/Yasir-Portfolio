# Copy to .env and fill in. Never commit .env.

# Public base URL, used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL. Local: run `npm run db:up` (docker-compose) and keep this value.
# Production: the Neon connection strings (the Vercel Neon integration sets both).
# If unset, public pages render the built-in default content and /admin is disabled.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"
# Direct (unpooled) connection, used only by `prisma migrate`. Optional locally.
DATABASE_URL_UNPOOLED=""

# Secret used to hash visitor IPs for contact-form and login rate limiting (any long random string).
IP_HASH_SALT=""

# The only email allowed into /admin, and its password hash.
# Generate the hash with: npm run admin:hash -- "a long password"
ADMIN_EMAIL="yasirabdullahearthix@gmail.com"
ADMIN_PASSWORD_HASH=""

# Resend: email alerts for contact-form messages (messages are saved to the database either way).
RESEND_API_KEY=""
# Verified sender, e.g. "Portfolio <hello@yourdomain.com>". Defaults to Resend's onboarding sender,
# which only delivers to the Resend account owner's address.
EMAIL_FROM=""
# Inbox that receives contact-form alerts.
CONTACT_TO_EMAIL="yasirabdullahearthix@gmail.com"

# Vercel Blob: profile photo, project covers, résumé PDFs and the share image.
# The Vercel Blob integration sets this; uploads are disabled without it.
BLOB_READ_WRITE_TOKEN=""

# Optional error monitoring (see src/lib/monitoring.ts). Leave empty to only log.
NEXT_PUBLIC_SENTRY_DSN=""
