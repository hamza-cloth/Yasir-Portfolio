# Copy to .env and fill in. Never commit .env.

# Public base URL, used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL. Local: run `npm run db:up` (docker-compose) and keep this value.
# Production: the pooled connection string from Neon.
# If unset, public pages render the built-in default content.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"

# Secret used to hash visitor IPs for contact-form rate limiting (any long random string).
IP_HASH_SALT=""

# Auth.js. Generate AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=""
# GitHub OAuth app (callback: <site>/api/auth/callback/github). Optional if you only use magic links.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# The only email allowed into /admin.
ADMIN_EMAIL="yasirabdullahearthix@gmail.com"

# Resend: contact-form emails and admin magic links.
RESEND_API_KEY=""
# Verified sender, e.g. "Portfolio <hello@yourdomain.com>".
EMAIL_FROM=""
# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL="yasirabdullahearthix@gmail.com"

# UploadThing token for portrait and cover image uploads.
UPLOADTHING_TOKEN=""
