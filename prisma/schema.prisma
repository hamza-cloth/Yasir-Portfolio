generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum ProjectCategory {
  PRODUCT
  WEB
  NETWORKING
}

// Picks the code-drawn mockup and architecture diagram for a project.
enum ProjectVisual {
  CLINIC_CONSOLE
  STOREFRONT
  SEAT_MAP
}

enum LabTopology {
  INTER_VLAN
  OSPF_SINGLE_AREA
  ACL_PAT_EDGE
  DHCP_RELAY
}

enum CredentialKind {
  DEGREE
  TRAINING
  CERTIFICATION
}

enum CredentialStatus {
  IN_PROGRESS
  COMPLETED
}

enum SkillDomain {
  ROUTING_SWITCHING
  NETWORK_SERVICES
  SECURITY
  FRONTEND
  BACKEND
  SUPPORT_HARDWARE
}

enum MessageTopic {
  HIRING
  PROJECT
  NETWORK_HELP
  OTHER
}

model SiteSettings {
  id           Int       @id @default(1)
  name         String
  roleLine     String
  email        String
  location     String
  availability String
  linkedinUrl  String?
  githubUrl    String?
  photoUrl     String?
  photoKey     String?
  aboutStory   String    @db.Text
  principles   Json      @default("[]")
  nowItems     String[]
  nowUpdatedAt DateTime?
  // Home-page looks: which are on, and how the next one is chosen (random, sequential, fixed).
  looksEnabled String[]  @default(["midnight-ink", "porcelain", "midnight-ops", "sunset-fibre", "aurora"])
  looksMode    String    @default("fixed")
  looksFixed   String    @default("midnight-ink")
  openToWork   Boolean   @default(true)
  // Per-page SEO overrides: { "/about": { "title": "…", "description": "…" } }.
  seo          Json      @default("{}")
  ogImageUrl   String?
  indexable    Boolean   @default(true)
  sitemap      Boolean   @default(true)
  updatedAt    DateTime  @updatedAt
}

model Project {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  tagline        String
  summary        String
  statusLabel    String
  categories     ProjectCategory[]
  role           String?
  type           String?
  stack          String[]
  visual         ProjectVisual
  overview       String            @db.Text
  decisions      Json              @default("[]")
  coverImageUrl  String?
  featured       Boolean           @default(false)
  liveUrl        String?
  githubUrl      String?
  gallery        String[]          @default([])
  seoTitle       String?
  seoDescription String?
  published      Boolean           @default(false)
  publishedAt    DateTime?
  order          Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([published, order])
}

model Note {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String    @db.Text
  tags        String[]
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Lab {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  summary        String
  topology       LabTopology
  configs        Json        @default("[]")
  verifyCommands String[]
  published      Boolean     @default(false)
  publishedAt    DateTime?
  order          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([published, order])
}

model Certification {
  id            String           @id @default(cuid())
  title         String
  issuer        String
  kind          CredentialKind
  status        CredentialStatus
  location      String?
  startYear     Int?
  endYear       Int?
  credentialUrl String?
  fileUrl       String?
  published     Boolean          @default(false)
  publishedAt   DateTime?
  order         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([published, order])
}

model Experience {
  id          String    @id @default(cuid())
  role        String
  company     String
  location    String?
  summary     String    @db.Text
  highlights  String[]
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, order])
}

model Skill {
  id          String       @id @default(cuid())
  name        String
  layer       Int?
  domain      SkillDomain?
  // 1-5, optional.
  level       Int?
  published   Boolean      @default(true)
  publishedAt DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([layer, order])
  @@index([domain, order])
}

model Message {
  id        String       @id @default(cuid())
  name      String
  email     String
  topic     MessageTopic
  body      String       @db.Text
  ipHash    String
  read      Boolean      @default(false)
  starred   Boolean      @default(false)
  archived  Boolean      @default(false)
  spam      Boolean      @default(false)
  emailSent Boolean      @default(false)
  labels    String[]     @default([])
  createdAt DateTime     @default(now())

  @@index([read, createdAt])
  @@index([archived, spam, createdAt])
}

// A reply sent from the admin; messageId has no foreign key so replies survive the trash.
model MessageReply {
  id        String   @id @default(cuid())
  messageId String
  subject   String
  body      String   @db.Text
  sentBy    String
  createdAt DateTime @default(now())

  @@index([messageId, createdAt])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // argon2id hash; only the admin account has one. Set by the seed from ADMIN_PASSWORD.
  passwordHash  String?
  // OWNER, EDITOR or VIEWER. Checked on the server for every admin page and action.
  role          String    @default("OWNER")
  // TOTP two-factor: the secret is encrypted at rest; backup codes are stored as hashes.
  totpSecret    String?
  totpEnabled   Boolean   @default(false)
  backupCodes   String[]  @default([])
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String    @unique
  userId       String
  expires      DateTime
  ipHash       String?
  userAgent    String?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Every admin create, update and delete: who, what, when.
model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  summary   String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, createdAt])
}

// Privacy-friendly page views: a count per path per day. No cookies, IPs or user agents.
model PageView {
  id    String   @id @default(cuid())
  day   DateTime @db.Date
  path  String
  count Int      @default(0)

  @@unique([day, path])
  @@index([day])
}

// Uploaded résumé PDFs; exactly one may be active and linked from /resume.
model ResumeVersion {
  id        String   @id @default(cuid())
  label     String
  url       String
  pathname  String
  size      Int
  active    Boolean  @default(false)
  downloads Int      @default(0)
  createdAt DateTime @default(now())

  @@index([active])
}

// Every file in the Blob store, so the media library can show usage and delete safely.
model MediaAsset {
  id          String   @id @default(cuid())
  url         String   @unique
  pathname    String
  kind        String
  contentType String
  size        Int
  width       Int?
  height      Int?
  alt         String?
  folder      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ---- Admin upgrade ----

// Every sign-in attempt, for the login history and lockout. IPs are stored as salted hashes.
model LoginEvent {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  reason    String?
  ipHash    String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

// An invitation for a new admin user; the token is stored as a hash.
model Invite {
  id         String    @id @default(cuid())
  email      String
  role       String
  tokenHash  String    @unique
  expires    DateTime
  acceptedAt DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
}

// Site configuration by key: appearance, calculator pricing, home sections, navigation,
// services, announcement, notifications. Every value is validated with zod when saved.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// A prospective client: from the Hire Me form, the cost calculator, or added by hand.
model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String?
  source      String
  stage       String     @default("NEW")
  value       Int?
  projectType String?
  budget      String?
  timeline    String?
  details     String     @db.Text
  notes       String?    @db.Text
  followUpAt  DateTime?
  position    Int        @default(0)
  messageId   String?
  clientId    String?
  estimates   Estimate[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([stage, position])
  @@index([createdAt])
}

// A saved cost-calculator estimate, which can become a quote.
model Estimate {
  id           String   @id @default(cuid())
  number       String   @unique
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  input        Json
  low          Int
  high         Int
  weeksMin     Int
  weeksMax     Int
  summary      String   @db.Text
  status       String   @default("DRAFT")
  contactName  String?
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  company   String?
  quote     String   @db.Text
  rating    Int?
  photoUrl  String?
  status    String   @default("PENDING")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
}

model Notification {
  id        String   @id @default(cuid())
  kind      String
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model Subscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  status      String    @default("PENDING")
  token       String    @unique
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
}

model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String
  permanent Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  gstin     String?
  address   String?   @db.Text
  notes     String?   @db.Text
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Invoice {
  id        String    @id @default(cuid())
  number    String    @unique
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items     Json
  subtotal  Int
  gstRate   Float     @default(0)
  total     Int
  status    String    @default("DRAFT")
  issuedAt  DateTime  @default(now())
  dueAt     DateTime?
  paidAt    DateTime?
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, issuedAt])
}

// Earlier versions of a note, saved on every edit, restorable.
model NoteRevision {
  id        String   @id @default(cuid())
  noteId    String
  title     String
  excerpt   String
  body      String   @db.Text
  actor     String
  createdAt DateTime @default(now())

  @@index([noteId, createdAt])
}

// Deleted content, kept as a snapshot for 30 days so it can be restored.
model TrashItem {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  label     String
  data      Json
  deletedBy String
  deletedAt DateTime @default(now())

  @@index([deletedAt])
}

// Cookie-less analytics: one salted, daily-rotating hash per visitor per day, so unique
// visitors can be counted without identifying anyone.
model VisitorDay {
  day  DateTime @db.Date
  hash String

  @@id([day, hash])
}

// Daily counts by dimension: kind is "referrer", "device" or "country".
model StatDay {
  day   DateTime @db.Date
  kind  String
  value String
  count Int      @default(0)

  @@id([day, kind, value])
  @@index([kind, day])
}
